{
  "experiment": {
    "mode": null,
    "run_identifier": null,
    "selection": "selected",
    "subject_id": null,
    "timepoint": null
  },
  "inputs": {
    "eit_file": "data/source/data_from_repo/draeger_synthetic_draeger_20Hz.bin",
    "vendor": "draeger"
  },
  "name": "eit-full-preprocessing",
  "outputs": {
    "dir": "output/eit-full-preprocessing",
    "event_csvs": true,
    "figures": true,
    "parameters_csv": false,
    "postprocessing": false,
    "structured_export": true,
    "summary_json": true,
    "timestamped": true
  },
  "steps": [
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.load",
      "with": {
        "file": "@eit_file",
        "vendor": "@vendor"
      }
    },
    {
      "id": null,
      "in": {
        "signal": "raw_eit"
      },
      "out": {},
      "uses": "eit.detect_rates",
      "with": {
        "capture": true,
        "subject_type": "adult"
      }
    },
    {
      "id": null,
      "in": {
        "signal": "raw_eit"
      },
      "out": {},
      "uses": "eit.mdn_filter",
      "with": {
        "label": "mdn_filtered"
      }
    },
    {
      "id": null,
      "in": {
        "signal": "filtered_eit"
      },
      "out": {},
      "uses": "eit.global_impedance",
      "with": {}
    },
    {
      "id": null,
      "in": {
        "signal": "global_impedance"
      },
      "out": {},
      "uses": "eit.detect_breaths",
      "with": {
        "min_duration_s": 0.6666666667
      }
    },
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.normalize_breaths",
      "with": {}
    },
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.continuous_tiv",
      "with": {}
    },
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.eeli",
      "with": {}
    },
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.pixel_breaths",
      "with": {
        "phase_correction_mode": "negative amplitude"
      }
    },
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.pixel_tiv",
      "with": {
        "tiv_timing": "continuous"
      }
    },
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.roi_tiv_lungspace",
      "with": {
        "threshold": 0.15
      }
    },
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.roi_amplitude_lungspace",
      "with": {
        "threshold": 0.15
      }
    },
    {
      "id": null,
      "in": {},
      "out": {},
      "uses": "eit.roi_watershed",
      "with": {
        "threshold_fraction": 0.15
      }
    },
    {
      "id": null,
      "in": {
        "mask": "watershed_lungspace_mask"
      },
      "out": {},
      "uses": "eit.roi_filter_by_size",
      "with": {
        "connectivity": 1,
        "min_region_size": 10
      }
    }
  ]
}
